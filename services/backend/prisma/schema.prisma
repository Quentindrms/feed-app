// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Feed {
  id        String   @id @unique @default(uuid())
  title     String   @db.VarChar(150)
  link      String   @db.VarChar(200)
  createdAt DateTime @map("created_at") @db.Date()

  articles Article[]
}

model Article {
  id          String   @id @unique @default(uuid())
  guid        String   @unique
  title       String
  link        String
  publishDate DateTime @map("publish_date") @db.Date()
  description String   @db.VarChar(300)
  isRead      Boolean  @default(false) @map("is_read") @db.Boolean()
  isFavorite  Boolean  @default(false) @map("is_favorite") @db.Boolean()
  createdAt   DateTime @map("created_at") @db.Date()

  feedId String

  feed Feed @relation(fields: [feedId], references: [id])
}
